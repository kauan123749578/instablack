{
  "manifest_version": 3,
  "name": "Instablack Session Sync",
  "version": "1.1.0",
  "description": "Envia cookies completos do Instagram + fingerprint do Chrome para o painel Instablack.",
  "action": {
    "default_title": "Instablack Sync",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["cookies", "storage"],
  "host_permissions": [
    "*://*.instagram.com/*",
    "*://instagram.com/*",
    "*://*.up.railway.app/*",
    "*://localhost/*",
    "*://127.0.0.1/*"
  ],
  "optional_host_permissions": ["*://*/*"]
}
